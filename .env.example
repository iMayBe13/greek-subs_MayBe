# Public base URL where Stremio can reach this server (no trailing slash). On Render it falls back to RENDER_EXTERNAL_URL if empty.
# Local test: http://127.0.0.1:7000   Hosted: https://your-app.example.com
BASE_URL=http://127.0.0.1:7000
PORT=7000
# Required outside local dev (the server refuses to start without it, or with a placeholder): 32+ random characters.
# Encrypts each user's API keys inside their install URL. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Where downloaded + converted subtitle files are cached
CACHE_DIR=./cache

# GreekSubs.net base URL (Greek sites change domains often)
GREEKSUBS_BASE=https://greeksubs.net

# Size cap of the disk cache (CACHE_DIR) in MB: default 500, 0 = no cap. Expired files are removed at startup and hourly;
# when the folder is over the cap the oldest files go first.
# CACHE_MAX_MB=500

# How many reverse proxies sit in front of the server, so the rate limits see each visitor's own IP (0 to 10).
# Default: 1 when RENDER is set, otherwise 0. Render alone: 1. Render with your own Cloudflare proxy in front: 2.
# Cloudflare Tunnel next to the server: 1. The older TRUST_PROXY=1 still works and means 1.
# TRUST_PROXY_HOPS=1

# Take the visitor's IP from the CF-Connecting-IP header. Only when EVERY request passes through Cloudflare: anyone who
# can reach the server directly could forge it and dodge the rate limits. Default off.
# TRUST_CF_CONNECTING_IP=1

# "Test my keys" on the configure page (POST /api/test) can check credentials from this server's IP.
# Default: on for local development, off on a hosted server. 1 or 0 overrides.
# ENABLE_KEY_TEST=1

# Keys for optional manual live checks only. The addon itself never reads them: it takes each user's keys
# from the configure page. Leave empty unless you run such checks.
SUBSOURCE_API_KEY=
SUBDL_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
DEEPL_API_KEY=
GEMINI_API_KEY=

# Cloudflare KV for AI translations (optional). Set all three or none: without all three, AI results are kept on disk (CACHE_DIR).
# API token permission: Workers KV Storage, write (the dashboard and the docs call it Edit or Write).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# AI translation: cues per Gemini request (default 250, minimum 50, maximum 400). Bigger = fewer requests against the daily quota.
# AI_CHUNK_CUES=250

# AI translation limits (in memory, reset at 00:00 UTC): jobs per user (their AI keys) and in all per day. Defaults 10 and 40.
# AI_USER_DAILY=10
# AI_GLOBAL_DAILY=40

# AI translation, Gemini model: a fixed model name (e.g. gemini-2.5-flash). Empty = the newest stable Flash model from the model list.
# AI_GEMINI_MODEL=
# AI translation, Gemini thinking level: MINIMAL, LOW, MEDIUM, HIGH, or UNSET (send none: the model's own default). Default LOW.
# AI_GEMINI_THINKING=LOW
